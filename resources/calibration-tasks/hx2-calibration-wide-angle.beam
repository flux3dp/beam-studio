        #svg_50 *[data-color] circle:not([stroke]),
        #svg_50 *[data-color] rect:not([stroke]),
        #svg_50 *[data-color] path:not([stroke]),
        #svg_50 *[data-color] polygon:not([stroke]) {
            fill-opacity: 1 !important;
            stroke-width: 0 !important;
        }

        *[data-wireframe] {
            stroke-width: 1px !important;
            stroke-opacity: 1.0 !important;
            stroke-dasharray: 0 !important;
            opacity: 1 !important;
            vector-effect: non-scaling-stroke !important;
            filter: none !important;
        }

        #svg_50 {
            overflow: visible;
        }</style>
