            fill-opacity: 0 !important;
            stroke-width: 1px !important;
            stroke-opacity: 1 !important;
            vector-effect: non-scaling-stroke !important;
        }

        #svg_50 *[data-color] ellipse[stroke=none],
        #svg_50 *[data-color] circle[stroke=none],
        #svg_50 *[data-color] rect[stroke=none],
        #svg_50 *[data-color] path[stroke=none],
